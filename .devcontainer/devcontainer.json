{
  "name": "DevOS Agent Engine — Java 21",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true,
      "installGradle": false
    }
  },
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  },
  "postCreateCommand": "java -version && mvn -version",
  "remoteUser": "vscode"
}
